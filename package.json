{
	"name": "relog.dev",
	"version": "0.1.0",
	"description": "Universal logging system",
	"homepage": "https://github.com/TimMikeladze/relog#readme",
	"bugs": {
		"url": "https://github.com/TimMikeladze/relog/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/relog.git"
	},
	"bin": {
		"relog": "./dist/cli.js",
		"relog.dev": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./client": {
			"import": {
				"types": "./dist/client.d.ts",
				"default": "./dist/client.js"
			}
		},
		"./mcp": {
			"import": {
				"types": "./dist/mcp.d.ts",
				"default": "./dist/mcp.js"
			}
		},
		"./next": {
			"import": {
				"types": "./dist/next.d.ts",
				"default": "./dist/next.js"
			}
		},
		"./browser": {
			"import": {
				"types": "./dist/browser.d.ts",
				"default": "./dist/browser.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp -r --commit --push --tag",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@drizzle-team/brocli": "^0.10.2",
		"@duckdb/node-api": "^1.4.4-r.3",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"cronbake": "^0.4.0",
		"hyparquet-writer": "^0.13.0",
		"picocolors": "^1.1.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bun": "^1.3.9",
		"bumpp": "^10.4.1",
		"bunup": "^0.16.31",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.3"
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run format && bun run type-check"
	}
}
