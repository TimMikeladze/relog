{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"target": "ES2023",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		"noUnusedLocals": true,
		"noUnusedParameters": false,
		// noPropertyAccessFromIndexSignature deferred — this codebase has
		// hundreds of `obj.foo` accesses on inferred-as-record types
		// (process.env, parsed JSON meta, OTLP attrs) and turning the
		// flag on at once produces ~250 errors that aren't real bugs.
		// Revisit once those modules use typed shapes.
		"noPropertyAccessFromIndexSignature": false
	},

	"exclude": ["node_modules", "dist", "docs", "app", "examples"]
}
